[Unit]
Description=STM32 MPU6050/F9P live positioning and optional recording service
Documentation=https://github.com/lmy91/stm32-mpu6050-f9p-navigation
After=local-fs.target
ConditionPathExists=/dev/ttyAMA0
ConditionPathExists=/dev/ttyAMA2

[Service]
Type=simple
User=lmy
SupplementaryGroups=dialout
UMask=0002
WorkingDirectory=/home/lmy/stm32-mpu6050-f9p-navigation
ExecStart=/usr/bin/python3 -u tools/capture_serial.py /dev/ttyAMA0 --baud 460800 --hours 0 --output-dir /home/lmy/stm32-mpu6050-f9p-navigation/data/decoded --save imu gnss rawx --record-control /run/gnss-imu/recording.enabled --state-file /run/gnss-imu/live.json --ntrip-control /run/gnss-imu/ntrip.json --ubx-port /dev/ttyAMA2 --ubx-baud 115200
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=15
RuntimeDirectory=gnss-imu
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=restart
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
